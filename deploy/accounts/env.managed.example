# Template only. Split into private Compose/runtime files OUTSIDE git; chmod 600.
# Blank inputs intentionally fail until the operator supplies reviewed values.
# Compose interpolation (.env): immutable image + distinct DB credentials.
ACCOUNTS_IMAGE=
ACCOUNTS_ENV_FILE=
ACCOUNTS_KEY_FILE=
ACCOUNTS_DB_ADMIN_PASSWORD=
ACCOUNTS_DB_MIGRATOR_PASSWORD=
ACCOUNTS_DB_PASSWORD=
# Runtime service.env (managed mode requires no SMTP or sender values):
ACCOUNTS_DEBUG=0
ACCOUNTS_ACCOUNT_MODE=managed
ACCOUNTS_MAIL_DELIVERY=disabled
ACCOUNTS_ISSUER=
ACCOUNTS_ALLOWED_HOSTS=
ACCOUNTS_SECRET_KEY=
ACCOUNTS_SESSION_EPOCH=
ACCOUNTS_RSA_KEY_FILE=/run/secrets/accounts-rsa.pem
ACCOUNTS_TRUSTED_PROXY_IPS=
ACCOUNTS_ADMIN_ENABLED=0
PGHOST=db
PGPORT=5432
PGDATABASE=titan_accounts
PGUSER=titan_accounts_app
PGPASSWORD=
